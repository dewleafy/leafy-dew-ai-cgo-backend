# Server
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000

# Supabase
# TODO: Replace these with values from your Supabase project settings.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Encryption
# Must be 32 bytes when decoded. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Amazon Login With Amazon / SP-API
# TODO: Replace these with real Amazon app credentials from Seller Central Developer Console.
AMAZON_LWA_CLIENT_ID=your-amazon-lwa-client-id
AMAZON_LWA_CLIENT_SECRET=your-amazon-lwa-client-secret
AMAZON_APP_ID=your-amazon-sp-api-application-id

# These defaults are for North America. Change if your app starts in another region.
AMAZON_AUTH_BASE_URL=https://sellercentral.amazon.com
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_SP_API_REGION=NA

# Amazon Ads API
# TODO: Replace these with real Amazon Ads / Login With Amazon credentials.
AMAZON_ADS_CLIENT_ID=your-amazon-ads-client-id
AMAZON_ADS_CLIENT_SECRET=your-amazon-ads-client-secret
AMAZON_ADS_REDIRECT_URI=https://your-api-domain.com/api/amazon-ads/callback
AMAZON_ADS_REGION=NA

# Secure manual/automation endpoint secret
CRON_SECRET=replace-with-a-long-random-secret
