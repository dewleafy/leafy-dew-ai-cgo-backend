# Server
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000

# Supabase
# TODO: Replace these with values from your Supabase project settings.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Encryption
# Must be 32 bytes when decoded. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Amazon Login With Amazon / SP-API
# TODO: Replace these with real Amazon app credentials from Seller Central Developer Console.
AMAZON_LWA_CLIENT_ID=your-amazon-lwa-client-id
AMAZON_LWA_CLIENT_SECRET=your-amazon-lwa-client-secret
AMAZON_APP_ID=your-amazon-sp-api-application-id

# These defaults are for North America. Change if your app starts in another region.
AMAZON_AUTH_BASE_URL=https://sellercentral.amazon.com
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_SP_API_REGION=NA

# Amazon Ads API
# TODO: Replace these with real Amazon Ads / Login With Amazon credentials.
AMAZON_ADS_CLIENT_ID=your-amazon-ads-client-id
AMAZON_ADS_CLIENT_SECRET=your-amazon-ads-client-secret
AMAZON_ADS_REDIRECT_URI=https://your-api-domain.com/api/amazon-ads/callback
AMAZON_ADS_REGION=NA

# Amazon Selling Partner API read-only sync
# TODO: Replace these with real SP-API app values before connecting a seller account.
SP_API_LWA_CLIENT_ID=your-sp-api-lwa-client-id
SP_API_LWA_CLIENT_SECRET=your-sp-api-lwa-client-secret
SP_API_APPLICATION_ID=your-sp-api-application-id
SP_API_REGION=FE
SP_API_MARKETPLACE_ID=A21TJRUUN4KGV
SP_API_REDIRECT_URI=https://your-api-domain.com/api/amazon-sp/callback
SP_API_REFRESH_TOKEN=your-private-app-self-authorization-refresh-token
SP_API_AMAZON_SELLER_ID=your-amazon-selling-partner-id
# Optional. If omitted, ENCRYPTION_KEY is reused.
SP_API_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key-or-leave-unset
# Required for signed read-only SP-API requests.
SP_API_AWS_ACCESS_KEY_ID=your-sp-api-aws-access-key-id
SP_API_AWS_SECRET_ACCESS_KEY=your-sp-api-aws-secret-access-key
SP_API_AWS_SESSION_TOKEN=optional-session-token

# Secure manual/automation endpoint secret
CRON_SECRET=replace-with-a-long-random-secret
